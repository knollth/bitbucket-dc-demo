# Pin image tags so local test runs stay reproducible.
BITBUCKET_IMAGE=atlassian/bitbucket:9.6.4
POSTGRES_IMAGE=postgres:16-bookworm

# Database settings used by both Bitbucket and PostgreSQL.
BITBUCKET_DB_NAME=bitbucket
BITBUCKET_DB_USER=bitbucket
BITBUCKET_DB_PASSWORD=change-this-database-password

# Initial Bitbucket admin user.
BITBUCKET_ADMIN_USERNAME=admin
BITBUCKET_ADMIN_PASSWORD=change-this-admin-password
BITBUCKET_ADMIN_DISPLAY_NAME=Administrator
BITBUCKET_ADMIN_EMAIL=admin@example.com

# Instance display name shown in the UI.
BITBUCKET_DISPLAY_NAME=Bitbucket

# Atlassian 3-hour Bitbucket Data Center timebomb license. It auto-expires a
# few hours after the container starts; run `make destroy && make up` for a
# fresh one. Grab the latest from:
# https://developer.atlassian.com/platform/marketplace/timebomb-licenses-for-testing-server-apps/
BITBUCKET_

# Local access.
BITBUCKET_HTTP_PORT=7990
BITBUCKET_SSH_PORT=7999
BITBUCKET_BASE_URL=http://127.0.0.1:7990

# Optional bootstrap content created by seed.sh.
BITBUCKET_PROJECT_KEY=DEMO
BITBUCKET_PROJECT_NAME="Demo Project"
BITBUCKET_PROJECT_DESCRIPTION="Local Bitbucket demo project"
BITBUCKET_REPOSITORY_NAME=demo-repo
BITBUCKET_REPOSITORY_DESCRIPTION="Repository created by seed.sh"
